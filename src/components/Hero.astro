---
import { Image } from 'astro:assets';
---

<section class="relative overflow-hidden py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
        AI-Powered Early Seedling Stress Detection
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
        Revolutionary hyperspectral imaging and deep learning technology that detects seedling stress 
        <strong class="text-green-600">7-10 days before visual symptoms appear</strong>, 
        preventing $500M annual losses in the forestry industry.
      </p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a
          href="/treeextract-demo"
          class="rounded-md bg-green-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
        >
          Try Demo
        </a>
        <a href="/about" class="text-sm font-semibold leading-6 text-gray-900 dark:text-white">
          Learn more <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    
    <!-- Key Value Propositions -->
    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-green-600">
          <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Early Detection</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          Detect stress 7-10 days before visible symptoms with >90% accuracy
        </p>
      </div>
      
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-blue-600">
          <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Drone Integration</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          Hyperspectral drone imaging with cloud-based AI processing
        </p>
      </div>
      
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-purple-600">
          <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 010 0L21.75 9M21.75 9l-5.25-5.25M21.75 9v8.25" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Proven Results</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
          Active deployment with Auburn University research partnership
        </p>
      </div>
    </div>
    
    <div class="mt-16 flow-root sm:mt-24">
      <div class="relative rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4">
        <div class="relative rounded-md shadow-2xl ring-1 ring-gray-900/10">
          <img
            src="/images/platform-preview.jpg"
            alt="ForestAI Platform Interface showing hyperspectral analysis"
            class="w-full rounded-md"
          />
          <div class="absolute inset-0 rounded-md bg-gradient-to-t from-black/20 to-transparent"></div>
          <div class="absolute bottom-4 left-4 text-white">
            <p class="text-sm font-medium">Live Platform Dashboard</p>
            <p class="text-xs opacity-90">Real-time seedling health monitoring</p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Current Operations Banner -->
    <div class="mt-16 rounded-2xl bg-green-50 dark:bg-green-900/20 px-6 py-8">
      <div class="text-center">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Currently Operating</h3>
        <p class="mt-2 text-gray-600 dark:text-gray-300">
          Active contract with Auburn University - Processing real drone imagery data and delivering analysis reports through our cloud-based platform
        </p>
        <div class="mt-4 flex items-center justify-center gap-x-4 text-sm text-gray-500 dark:text-gray-400">
          <span class="flex items-center">
            <div class="h-2 w-2 rounded-full bg-green-600 mr-2"></div>
            MVP Deployed
          </span>
          <span class="flex items-center">
            <div class="h-2 w-2 rounded-full bg-blue-600 mr-2"></div>
            Active Customer
          </span>
          <span class="flex items-center">
            <div class="h-2 w-2 rounded-full bg-purple-600 mr-2"></div>
            Revenue Generating
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
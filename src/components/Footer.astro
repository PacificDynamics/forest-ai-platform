---
const navigation = {
  solutions: [
    { name: 'Tree Detection', href: '/demo' },
    { name: 'Health Analysis', href: '/demo' },
    { name: 'Species Classification', href: '/demo' },
    { name: 'Growth Tracking', href: '/demo' },
  ],
  company: [
    { name: 'About', href: '/about' },
    { name: 'Case Studies', href: '/case-studies' },
    { name: 'Features', href: '/features' },
    { name: 'Team', href: '/team' },
  ],
  legal: [
    { name: 'Privacy', href: '/privacy' },
    { name: 'Terms', href: '/terms' },
    { name: 'Cookie Policy', href: '/cookie-policy' },
  ],
};
---

<footer class="bg-white dark:bg-gray-900" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">
        <img class="h-7" src="/logo.svg" alt="ForestAI Logo" />
        <p class="text-sm leading-6 text-gray-600 dark:text-gray-400">
          Transforming forest management with AI-powered drone analysis.
        </p>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-gray-900 dark:text-white">Solutions</h3>
            <ul role="list" class="mt-6 space-y-4">
              {navigation.solutions.map((item) => (
                <li>
                  <a href={item.href} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-gray-900 dark:text-white">Company</h3>
            <ul role="list" class="mt-6 space-y-4">
              {navigation.company.map((item) => (
                <li>
                  <a href={item.href} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-1 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold leading-6 text-gray-900 dark:text-white">Legal</h3>
            <ul role="list" class="mt-6 space-y-4">
              {navigation.legal.map((item) => (
                <li>
                  <a href={item.href} class="text-sm leading-6 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-gray-900/10 dark:border-gray-100/10 pt-8 sm:mt-20 lg:mt-24">
      <p class="text-xs leading-5 text-gray-500 dark:text-gray-400">
        &copy; {new Date().getFullYear()} ForestAI Platform. All rights reserved.
      </p>
    </div>
  </div>
</footer>
---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="About Us" description="Learn about ForestAI's mission to revolutionize forestry management with AI-powered technology">
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
          About ForestAI
        </h1>
        <p class="mt-6 text-xl leading-8 text-gray-600 dark:text-gray-300">
          Revolutionizing forestry management with AI-powered early seedling stress detection using hyperspectral imaging and deep learning technology.
        </p>
      </div>

      <!-- Problem Statement -->
      <div class="mt-16 lg:mt-24">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">The Problem We Solve</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            The southeastern United States forestry industry plants 1.5 billion seedlings annually, yet environmental volatility has increased first-year seedling mortality by 15-20% in the past decade. Traditional monitoring relies on labor-intensive visual inspection that cannot detect problems until visible symptoms appear, resulting in <strong class="text-red-600">$150 million annual losses</strong> from failed plantings.
          </p>
        </div>
      </div>

      <!-- Our Solution -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Our Revolutionary Solution</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            ForestAI leverages breakthrough hyperspectral sensing and AI to identify seedling stress <strong class="text-green-600">7-10 days before visual symptoms appear</strong>. Our technology represents a fundamental shift from crude visual assessments to precise spectral analysis.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="rounded-2xl bg-green-50 dark:bg-green-900/20 p-8">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="flex h-8 w-8 items-center justify-center rounded-md bg-green-600">
                  <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 14.5M9.75 3.104L8.25 3.928M4.5 9.75v.75m15 0v-.75" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Hyperspectral AI</h3>
              </div>
            </div>
            <p class="mt-4 text-gray-600 dark:text-gray-300">
              Advanced algorithms processing hundreds of spectral bands to detect stress signatures invisible to traditional monitoring.
            </p>
          </div>

          <div class="rounded-2xl bg-blue-50 dark:bg-blue-900/20 p-8">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="flex h-8 w-8 items-center justify-center rounded-md bg-blue-600">
                  <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Drone Integration</h3>
              </div>
            </div>
            <p class="mt-4 text-gray-600 dark:text-gray-300">
              Dual-mode sensing platform combining drone-mounted hyperspectral cameras with ground-based validation sensors.
            </p>
          </div>

          <div class="rounded-2xl bg-purple-50 dark:bg-purple-900/20 p-8">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <div class="flex h-8 w-8 items-center justify-center rounded-md bg-purple-600">
                  <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Early Detection</h3>
              </div>
            </div>
            <p class="mt-4 text-gray-600 dark:text-gray-300">
              Deep learning models achieve >90% accuracy in preliminary testing, enabling intervention before visible damage.
            </p>
          </div>
        </div>
      </div>

      <!-- Current Services -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Current Services & Operations</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            We are an operating business currently providing services under contract with Auburn University, demonstrating real-world application of our technology.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Cloud-Based Analysis Platform</h3>
            <ul class="mt-4 space-y-2 text-gray-600 dark:text-gray-300">
              <li>• Development and maintenance of cloud-based seedling analysis platform</li>
              <li>• Processing DJI M3 drone imagery data</li>
              <li>• Seedling detection and counting algorithms</li>
              <li>• Web dashboard for viewing results and reports</li>
              <li>• Data visualization and reporting tools</li>
            </ul>
          </div>

          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Data Processing Services</h3>
            <ul class="mt-4 space-y-2 text-gray-600 dark:text-gray-300">
              <li>• Regular processing and analysis of drone imagery</li>
              <li>• Data cleaning, preprocessing, and quality control</li>
              <li>• Integration of processed data into analysis platform</li>
              <li>• Monthly data processing status reports</li>
              <li>• Analysis results and visualizations</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Target Market -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Target Market</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Addressing a <strong class="text-green-600">$2.5B+ total addressable market</strong> across three key segments:
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100 dark:bg-green-900">
              <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m0-6.75h6m6 0h6v-6.75m0 0h-6m6 0V9m-6 3h6m-6-3v3" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-semibold text-gray-900 dark:text-white">Commercial Timber Operations</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-300">
              Large plantation managers (Weyerhaeuser, Georgia-Pacific, TIMOs) controlling millions of acres with $10-15/acre annual investment potential.
            </p>
          </div>

          <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900">
              <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15l-.75 18H5.25L4.5 3z" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-semibold text-gray-900 dark:text-white">Government Forestry Agencies</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-300">
              State departments and USDA Forest Service managing 30% of southeastern forestland with environmental resilience mandates.
            </p>
          </div>

          <div class="text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-purple-100 dark:bg-purple-900">
              <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3s-4.5 4.03-4.5 9 2.015 9 4.5 9z" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-semibold text-gray-900 dark:text-white">Carbon Offset Programs</h3>
            <p class="mt-2 text-gray-600 dark:text-gray-300">
              Organizations requiring reforestation verification for carbon sequestration within the $2 billion voluntary carbon market.
            </p>
          </div>
        </div>
      </div>

      <!-- Company Background -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Company Background</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Founded in 2024 as ForestAI, we are developing environment-adaptive forestry technologies. Our founding team combines ideal technical expertise and industry experience with active research partnerships.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Current Development Stage</h3>
            <ul class="mt-4 space-y-2 text-gray-600 dark:text-gray-300">
              <li>• <strong>MVP Deployed:</strong> Cloud-based processing platform operational</li>
              <li>• <strong>Active Customer:</strong> Auburn University contract engagement</li>
              <li>• <strong>Technology Validation:</strong> >90% accuracy in controlled testing</li>
            </ul>
          </div>

          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Competitive Advantage</h3>
            <ul class="mt-4 space-y-2 text-gray-600 dark:text-gray-300">
              <li>• <strong>Seedling-Specific:</strong> Focus on early-stage monitoring vs. mature trees</li>
              <li>• <strong>Comprehensive Signatures:</strong> Specific stressor identification</li>
              <li>• <strong>Integrated Platform:</strong> End-to-end solution for forest management</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="mt-16 rounded-2xl bg-green-600 px-6 py-16 sm:p-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-white">Ready to Transform Your Forest Management?</h2>
          <p class="mt-6 text-lg leading-8 text-green-100">
            Join Auburn University and other forward-thinking organizations in leveraging AI-powered forestry solutions
---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Our Team" description="Meet the expert team behind ForestAI's revolutionary forestry technology">
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
          Our Team
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          We're a dedicated team of AI researchers, forestry experts, and software engineers committed to revolutionizing forest management through cutting-edge technology.
        </p>
      </div>
      
      <ul role="list" class="mx-auto mt-20 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3">
        <!-- Dr. Ping Yang - CEO/Founder -->
        <li>
          <div class="aspect-[3/2] w-full rounded-2xl bg-gray-100 dark:bg-gray-800 object-cover">
            <!-- Placeholder for photo - replace with actual photo -->
            <div class="flex h-full items-center justify-center">
              <div class="h-20 w-20 rounded-full bg-green-600 flex items-center justify-center">
                <span class="text-2xl font-bold text-white">PY</span>
              </div>
            </div>
          </div>
          <h3 class="mt-6 text-lg font-semibold leading-8 tracking-tight text-gray-900 dark:text-white">Dr. Ping Yang</h3>
          <p class="text-base leading-7 text-green-600 dark:text-green-400">CEO & Founder</p>
          <p class="mt-4 text-base leading-6 text-gray-600 dark:text-gray-300">
            PhD in GeoInformatics from Wuhan University. 15 years of environmental modeling research and 10 years of industrial experience. Expert in geospatial technologies, cloud computing, and AI. Research focuses on drought prediction using AI and hyperspectral imagery for forest health monitoring.
          </p>
          <div class="mt-6 flex gap-x-6">
            <a href="https://www.linkedin.com/in/ping-yang-36ab77301/" class="text-gray-400 hover:text-gray-500" target="_blank">
              <span class="sr-only">LinkedIn</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </li>

        <!-- Dr. Chen Ding - Collaborative PI -->
        <li>
          <div class="aspect-[3/2] w-full rounded-2xl bg-gray-100 dark:bg-gray-800 object-cover">
            <div class="flex h-full items-center justify-center">
              <div class="h-20 w-20 rounded-full bg-green-600 flex items-center justify-center">
                <span class="text-2xl font-bold text-white">CD</span>
              </div>
            </div>
          </div>
          <h3 class="mt-6 text-lg font-semibold leading-8 tracking-tight text-gray-900 dark:text-white">Dr. Chen Ding</h3>
          <p class="text-base leading-7 text-green-600 dark:text-green-400">Research Partner & Forest Ecology Expert</p>
          <p class="mt-4 text-base leading-6 text-gray-600 dark:text-gray-300">
            Assistant Professor at Auburn University with expertise in forest ecology and genetics. Research focuses on Populus, Pinus taeda, and Picea species. Specializes in tree improvement and forest genetics research with valuable Auburn forestry research facility connections for validation studies.
          </p>
          <div class="mt-6 flex gap-x-6">
            <a href="https://scholar.google.com/citations?hl=en&user=qKGMQ2IAAAAJ" class="text-gray-400 hover:text-gray-500" target="_blank">
              <span class="sr-only">Google Scholar</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
              </svg>
            </a>
          </div>
        </li>

        <!-- Dr. Yuede Ji - AI Expert -->
        <li>
          <div class="aspect-[3/2] w-full rounded-2xl bg-gray-100 dark:bg-gray-800 object-cover">
            <div class="flex h-full items-center justify-center">
              <div class="h-20 w-20 rounded-full bg-green-600 flex items-center justify-center">
                <span class="text-2xl font-bold text-white">YJ</span>
              </div>
            </div>
          </div>
          <h3 class="mt-6 text-lg font-semibold leading-8 tracking-tight text-gray-900 dark:text-white">Dr. Yuede Ji</h3>
          <p class="text-base leading-7 text-green-600 dark:text-green-400">AI Research Partner & Computer Science Expert</p>
          <p class="mt-4 text-base leading-6 text-gray-600 dark:text-gray-300">
            Assistant Professor at UT Arlington Computer Science. Director of Graph Lab focusing on high-performance computing and graph AI. Publications in USENIX Security, SC, HPDC. AI algorithm expertise critical for spectral signature matching technology. Supported by NSF, DOE, and Google grants.
          </p>
          <div class="mt-6 flex gap-x-6">
            <a href="https://scholar.google.com/citations?hl=en&user=1-GjVYgAAAAJ" class="text-gray-400 hover:text-gray-500" target="_blank">
              <span class="sr-only">Google Scholar</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
              </svg>
            </a>
          </div>
        </li>

        <!-- Dr. Yan Li - Robotics Lead -->
        <li>
          <div class="aspect-[3/2] w-full rounded-2xl bg-gray-100 dark:bg-gray-800 object-cover">
            <div class="flex h-full items-center justify-center">
              <div class="h-20 w-20 rounded-full bg-green-600 flex items-center justify-center">
                <span class="text-2xl font-bold text-white">YL</span>
              </div>
            </div>
          </div>
          <h3 class="mt-6 text-lg font-semibold leading-8 tracking-tight text-gray-900 dark:text-white">Dr. Yan Li</h3>
          <p class="text-base leading-7 text-green-600 dark:text-green-400">Robotics & Computer Vision Expert</p>
          <p class="mt-4 text-base leading-6 text-gray-600 dark:text-gray-300">
            PhD in Computer Science from UT Knoxville. Expertise in robotics, machine learning, and computer vision. Research in visual-inertial sensor fusion, automated image identification, and robotic navigation systems. Experience with camera calibration and sensor fusion provides critical hyperspectral sensing platform expertise.
          </p>
          <div class="mt-6 flex gap-x-6">
            <a href="https://scholar.google.com/citations?hl=en&user=1OzbIskAAAAJ" class="text-gray-400 hover:text-gray-500" target="_blank">
              <span class="sr-only">Google Scholar</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
              </svg>
            </a>
          </div>
        </li>
      </ul>

      <!-- Partnerships & Collaborations -->
      <div class="mt-32">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Partnerships & Collaborations</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Our success is built on strong partnerships with leading research institutions and industry organizations.
          </p>
        </div>
        
        <!-- Partner Logos -->
        <div class="mt-12">
          <div class="grid grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-3">
            <!-- Auburn University -->
            <div class="col-span-1 flex justify-center items-center bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm">
              <div class="text-center">
                <div class="h-16 w-16 mx-auto mb-3 bg-orange-600 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-xl">AU</span>
                </div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">Auburn University</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">School of Forestry</p>
              </div>
            </div>
            
            <!-- UT Arlington -->
            <div class="col-span-1 flex justify-center items-center bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm">
              <div class="text-center">
                <div class="h-16 w-16 mx-auto mb-3 bg-blue-600 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-lg">UTA</span>
                </div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">UT Arlington</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Computer Science</p>
              </div>
            </div>
            
            <!-- American Forest Congress -->
            <div class="col-span-1 flex justify-center items-center bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm">
              <div class="text-center">
                <div class="h-16 w-16 mx-auto mb-3 bg-emerald-700 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold text-lg">AFC</span>
                </div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">American Forest</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Congress</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Partnership Details -->
        <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
        </div>
      </div>
    </div>
  </div>
</MainLayout>
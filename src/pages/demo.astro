---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Demo" description="Experience ForestAI's technology through our interactive demos and prototypes">
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
          Experience ForestAI Technology
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Explore our AI-powered forest analysis capabilities through interactive demos and see how our technology detects seedling stress before it becomes visible.
        </p>
      </div>

      <!-- Platform Status -->
      <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Production Platform -->
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-md bg-green-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Production Platform</h3>
              <p class="text-sm text-green-600 dark:text-green-400">Currently Active</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600 dark:text-gray-300">
            Our full production platform is currently deployed and processing real drone imagery for Auburn University. This system includes hyperspectral analysis, seedling detection, and stress classification capabilities.
          </p>
          <div class="mt-6">
            <a
              href="https://forestai-platform.web.app/"
              class="inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500"
              target="_blank"
            >
              Access Production System
              <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Research Prototype -->
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-md bg-blue-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 14.5M9.75 3.104L8.25 3.928M4.5 9.75v.75m15 0v-.75" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Interactive Research Demo</h3>
              <p class="text-sm text-blue-600 dark:text-blue-400">Public Access</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600 dark:text-gray-300">
            Experience our tree detection and analysis algorithms through this interactive research prototype. Upload your own forestry images and see our AI in action.
          </p>
          <div class="mt-6">
            <a
              href="https://huggingface.co/spaces/forestaiUs/ForestAI-TreeExtraction"
              class="inline-flex items-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500"
              target="_blank"
            >
              Try Interactive Demo
              <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Technology Showcase -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Technology Capabilities</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Our AI platform combines multiple advanced technologies to provide comprehensive forestry analysis.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <!-- Tree Detection -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Individual Tree Detection</h3>
              </div>
            </div>
            <p class="mt-4 text-gray-600 dark:text-gray-300">
              Advanced computer vision algorithms identify and segment individual trees and seedlings from drone imagery with high precision.
            </p>
            <ul class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              <li>• Seedling counting and mapping</li>
              <li>• Species classification</li>
              <li>• Growth stage assessment</li>
            </ul>
          </div>

          <!-- Health Analysis -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Stress Detection</h3>
              </div>
            </div>
            <p class="mt-4 text-gray-600 dark:text-gray-300">
              Hyperspectral analysis detects stress signatures in seedlings 7–14 days before visual symptoms appear.
            </p>
            <ul class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              <li>• Drought stress identification</li>
              <li>• Disease detection</li>
              <li>• Pest damage assessment</li>
            </ul>
          </div>

          <!-- Reporting -->
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-medium text-gray-900 dark:text-white">Analysis Reports</h3>
              </div>
            </div>
            <p class="mt-4 text-gray-600 dark:text-gray-300">
              Comprehensive reports with visualizations, maps, and actionable insights for forest management decisions.
            </p>
            <ul class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              <li>• Interactive dashboards</li>
              <li>• Trend analysis</li>
              <li>• Intervention recommendations</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Technical Specifications -->
      <div class="mt-16 rounded-2xl bg-green-50 dark:bg-green-900/20 px-6 py-12">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Technical Specifications</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Built on cutting-edge AI and cloud infrastructure for scalable forest management.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-green-600">
              <span class="text-lg font-bold text-white">AI</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Deep Learning Models</h3>
            <ul class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              <li>Hyperspectral CNN architectures</li>
              <li>>90% accuracy in testing</li>
              <li>Real-time inference</li>
            </ul>
          </div>

          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-blue-600">
              <span class="text-lg font-bold text-white">☁</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Cloud Infrastructure</h3>
            <ul class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              <li>Scalable processing pipeline</li>
              <li>Automated data workflows</li>
              <li>Secure data storage</li>
            </ul>
          </div>

          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-purple-600">
              <span class="text-lg font-bold text-white">📊</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Data Processing</h3>
            <ul class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              <li>DJI Matrice 3M drone compatibility</li>
              <li>Hyperspectral analysis</li>
              <li>Automated reporting</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="mt-16 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Ready to Transform Your Forest Management?</h2>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Contact us to learn how ForestAI can help prevent seedling losses and optimize your reforestation efforts.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a
            href="/contact"
            class="rounded-md bg-green-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-500"
          >
            Contact Us
          </a>
          <a href="/about" class="text-sm font-semibold leading-6 text-gray-900 dark:text-white">
            Learn More <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
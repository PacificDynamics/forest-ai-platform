---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact Us" description="Get in touch with ForestAI to learn how our AI-powered forest analysis can transform your reforestation efforts">
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
          Get in Touch
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Ready to transform your forest management with AI? Contact us to learn how ForestAI can help prevent seedling losses and optimize your reforestation efforts.
        </p>
      </div>

      <!-- Contact Options -->
      <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Direct Email Contact -->
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-md bg-green-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Email Us Directly</h3>
              <p class="text-sm text-green-600 dark:text-green-400">Quick and Easy</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600 dark:text-gray-300">
            Send us an email directly to discuss your forest management needs, request a demo, or learn more about our AI solutions.
          </p>
          <div class="mt-6">
            <a
              href={`mailto:${import.meta.env.FOREST_AI_REPLY_EMAIL}?subject=ForestAI%20Inquiry&body=Hello%20ForestAI%20team,%0A%0AI'm%20interested%20in%20learning%20more%20about%20your%20AI-powered%20forest%20analysis%20solutions.%0A%0APlease%20include:%0A-%20Your%20organization%20name%0A-%20Type%20of%20forest%20management%20you're%20involved%20in%0A-%20Specific%20challenges%20you're%20facing%0A-%20How%20you%20heard%20about%20ForestAI%0A%0AThank%20you!`}
              class="inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500"
            >
              Send Email
              <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </a>
          </div>
          <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
            Email: <a href={`mailto:${import.meta.env.FOREST_AI_REPLY_EMAIL}`} class="text-green-600 hover:text-green-500">{import.meta.env.FOREST_AI_REPLY_EMAIL}</a>
          </p>
        </div>

        <!-- Contact Form -->
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-md bg-blue-600">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Contact Form</h3>
              <p class="text-sm text-blue-600 dark:text-blue-400">Structured Inquiry</p>
            </div>
          </div>
          <p class="mt-4 text-gray-600 dark:text-gray-300">
            Fill out our contact form to provide us with more details about your specific needs and requirements.
          </p>
          
          <form class="mt-6 space-y-4" action={`mailto:${import.meta.env.FOREST_AI_REPLY_EMAIL}`} method="post" enctype="text/plain">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Name *</label>
              <input
                type="text"
                name="name"
                id="name"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white sm:text-sm"
                placeholder="Your full name"
              />
            </div>
            
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email *</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white sm:text-sm"
                placeholder="your.email@example.com"
              />
            </div>
            
            <div>
              <label for="organization" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Organization</label>
              <input
                type="text"
                name="organization"
                id="organization"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white sm:text-sm"
                placeholder="Your organization name"
              />
            </div>
            
            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Subject *</label>
              <select
                name="subject"
                id="subject"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white sm:text-sm"
              >
                <option value="">Select a topic</option>
                <option value="Demo Request">Demo Request</option>
                <option value="Pricing Inquiry">Pricing Inquiry</option>
                <option value="Technical Questions">Technical Questions</option>
                <option value="Partnership Opportunities">Partnership Opportunities</option>
                <option value="General Inquiry">General Inquiry</option>
              </select>
            </div>
            
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Message *</label>
              <textarea
                name="message"
                id="message"
                rows="4"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-green-500 focus:ring-green-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white sm:text-sm"
                placeholder="Tell us about your forest management needs and how we can help..."
              ></textarea>
            </div>
            
            <div class="flex items-center justify-end">
              <button
                type="submit"
                class="rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500"
              >
                Send Message
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Additional Contact Information -->
      <div class="mt-16 rounded-2xl bg-gray-50 dark:bg-gray-800 px-6 py-12">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Other Ways to Connect</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            We're here to help you understand how AI can revolutionize your forest management practices.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-green-600">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 14.5M9.75 3.104L8.25 3.928M4.5 9.75v.75m15 0v-.75" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Try Our Demo</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              Experience our technology firsthand with our interactive demo.
            </p>
            <a href="/demo" class="mt-4 inline-block text-sm text-green-600 hover:text-green-500">
              View Demo →
            </a>
          </div>

          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-blue-600">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Case Studies</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              See how our technology is already making an impact in real-world applications.
            </p>
            <a href="/case-studies" class="mt-4 inline-block text-sm text-green-600 hover:text-green-500">
              View Case Studies →
            </a>
          </div>

          <div class="text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-purple-600">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Meet Our Team</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              Learn about the experts behind ForestAI's innovative technology.
            </p>
            <a href="/team" class="mt-4 inline-block text-sm text-green-600 hover:text-green-500">
              Meet the Team →
            </a>
          </div>
        </div>
      </div>

      <!-- Response Time -->
      <div class="mt-16 text-center">
        <div class="mx-auto max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">We'll Get Back to You</h2>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
            We appreciate your interest in ForestAI and will respond to your inquiry as soon as possible. For urgent matters, please include "URGENT" in your subject line.
          </p>
        </div>
      </div>
    </div>
  </div>
</MainLayout> 
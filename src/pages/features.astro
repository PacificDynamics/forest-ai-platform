---
import MainLayout from '../layouts/MainLayout.astro';
import Features from '../components/Features.astro';

---

<MainLayout title="Products & Services" description="Comprehensive AI-powered forest analysis solutions and current service offerings">
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
          Products & Services
        </h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Comprehensive AI-powered forest analysis solutions currently deployed and generating revenue through our cloud-based platform.
        </p>
      </div>

      <!-- Development Stage & Current Status -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Current Development Stage</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            We are an operating business with deployed technology and active customers.
          </p>
        </div>
        
        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="rounded-2xl bg-green-50 dark:bg-green-900/20 p-8 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-green-600">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">MVP Deployed</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              Cloud-based processing platform operational and processing real drone imagery data
            </p>
          </div>
          
          <div class="rounded-2xl bg-blue-50 dark:bg-blue-900/20 p-8 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-blue-600">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Active Customer</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              Auburn University contract engagement with ongoing data processing and analysis
            </p>
          </div>
          
          <div class="rounded-2xl bg-purple-50 dark:bg-purple-900/20 p-8 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-md bg-purple-600">
              <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Revenue Generating</h3>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              Contract services generating revenue through data processing and platform maintenance
            </p>
          </div>
        </div>
      </div>

      <!-- Current Service Offerings -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Current Service Offerings</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            We are currently providing these services under contract with Auburn University, demonstrating real-world application of our technology.
          </p>
        </div>
        
        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center mb-6">
              <div class="flex-shrink-0">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-green-600">
                  <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Cloud-Based Analysis Platform</h3>
                <p class="text-sm text-green-600 dark:text-green-400">Production System</p>
              </div>
            </div>
            <ul class="space-y-3 text-gray-600 dark:text-gray-300">
              <li class="flex items-start">
                <span class="text-green-600 mr-2">•</span>
                Development and maintenance of cloud-based seedling analysis platform
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">•</span>
                Processing DJI M3 drone imagery data with automated workflows
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">•</span>
                Seedling detection and counting algorithms with >90% accuracy
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">•</span>
                Web dashboard for viewing results and generating reports
              </li>
              <li class="flex items-start">
                <span class="text-green-600 mr-2">•</span>
                Data visualization and reporting tools with trend analysis
              </li>
            </ul>
            <div class="mt-6">
              <a href="/demo" class="text-sm font-semibold text-green-600 hover:text-green-500">
                View Platform Demo →
              </a>
            </div>
          </div>

          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center mb-6">
              <div class="flex-shrink-0">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-blue-600">
                  <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Data Processing Services</h3>
                <p class="text-sm text-blue-600 dark:text-blue-400">Ongoing Contract</p>
              </div>
            </div>
            <ul class="space-y-3 text-gray-600 dark:text-gray-300">
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">•</span>
                Regular processing and analysis of drone imagery data
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">•</span>
                Data cleaning, preprocessing, and quality control
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">•</span>
                Integration of processed data into analysis platform
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">•</span>
                Monthly data processing status reports
              </li>
              <li class="flex items-start">
                <span class="text-blue-600 mr-2">•</span>
                Analysis results and visualizations for research
              </li>
            </ul>
            <div class="mt-6">
              <a href="/case-studies" class="text-sm font-semibold text-blue-600 hover:text-blue-500">
                View Case Studies →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Technology Features -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Technology Features</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Our platform combines multiple advanced technologies to provide comprehensive forestry analysis.
          </p>
        </div>
        
        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center mb-4">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Advanced Tree Detection</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Automatically identify and count trees from drone imagery using state-of-the-art AI models with >90% accuracy.
            </p>
            <ul class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              <li>• Seedling counting and mapping</li>
              <li>• Species classification</li>
              <li>• Growth stage assessment</li>
            </ul>
          </div>

          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center mb-4">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Health Analysis</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Monitor forest health through hyperspectral analysis and early disease detection 7-10 days before visual symptoms.
            </p>
            <ul class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              <li>• Drought stress identification</li>
              <li>• Disease detection</li>
              <li>• Pest damage assessment</li>
            </ul>
          </div>

          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-8">
            <div class="flex items-center mb-4">
              <div class="flex-shrink-0">
                <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Report Generation</h3>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Generate detailed reports with insights and recommendations for forest management decisions.
            </p>
            <ul class="mt-4 text-sm text-gray-500 dark:text-gray-400">
              <li>• Interactive dashboards</li>
              <li>• Trend analysis</li>
              <li>• Intervention recommendations</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Platform Screenshots -->
      <div class="mt-16">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Platform Screenshots</h2>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            See our technology in action with real platform interfaces and analysis results.
          </p>
        </div>
        
        <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-6">
            <img 
              src="/images/platform-preview.jpg" 
              alt="ForestAI Platform Dashboard showing seedling analysis"
              class="w-full rounded-lg shadow-lg"
            />
            <div class="mt-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Platform Dashboard</h3>
              <p class="text-sm text-gray-600 dark:text-gray-300">
                Real-time seedling health monitoring and analysis interface
              </p>
            </div>
          </div>
          
          <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-6">
            <img 
              src="/images/platform-foresthealth.jpg" 
              alt="Forest health analysis results and visualizations"
              class="w-full rounded-lg shadow-lg"
            />
            <div class="mt-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Health Analysis Results</h3>
              <p class="text-sm text-gray-600 dark:text-gray-300">
                Comprehensive forest health assessment with stress detection
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Call to Action -->
      <div class="mt-16 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Ready to Transform Your Forest Management?</h2>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          Contact us to learn how ForestAI can help prevent seedling losses and optimize your reforestation efforts.
        </p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a
            href="/demo"
            class="rounded-md bg-green-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-500"
          >
            Try Our Demo
          </a>
          <a href="/about" class="text-sm font-semibold leading-6 text-gray-900 dark:text-white">
            Learn More <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>